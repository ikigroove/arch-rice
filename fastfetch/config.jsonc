{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch",
        "padding": {
            "top": 1,
            "left": 2
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        "break",
        "title",
        {
            "type": "os",
            "key": "os      "
        },
        {
            "type": "wm",
            "key": "de      "
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": "pkgs    "
        },
        {
            "type": "shell",
            "key": "shell   "
        },
        {
            "type": "terminal",
            "key": "term    "
        },
        {
            "type": "kernel",
            "key": "kernel  "
        },
        "break",
        {
            "type": "cpu",
            "key": "cpu     ",
            "format": "{1} ({8})" 
        },
        {
            "type": "gpu",
            "key": "gpu     ",
            "format": "{2} ({4})"
        },

        {
            "type": "memory",
            "key": "memory  "
        },
        {
            "type": "swap",
            "key": "zram    "
        },
        {
            "type": "disk",
            "key": "disk    "
        },
        {
            "type": "battery",
            "key": "battery "
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        },
        "break"
    ]
}

